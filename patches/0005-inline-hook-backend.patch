diff --git a/glue/hk/hk.c b/glue/hk/hk.c
new file mode 100644
index 0000000..f8aace5
--- /dev/null
+++ b/glue/hk/hk.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+#include "hk.h"
+#include "hk_ptr.h"
+#include "hk_kprobe.h"
+#include "hk_kretprobe.h"
+#include "hk_redir.h"
+#include "hk_sighook.h"
+#include "hk_inline.h"
+#include "hk_patch.h"
+
+static struct hk_cfg g_cfg;
+static bool g_exiting;
+
+/*
+ * the body of a function whose address was taken is named name$type on a clang cfi
+ * build, and the suffix is not something a caller can know. the walk that used to
+ * find it goes through the kernel's symbol iterator, whose callback is four
+ * arguments on one kernel and three on another, and passing the wrong one is a cfi
+ * failure rather than a wrong answer. the stub the plain symbol names is a branch to
+ * that body, so the body is reached by following it, which costs no callback and no
+ * allocation and therefore also works from a probe handler
+ */
+#define HK_STUB_FOLLOW 8
+
+static u32 hk_read_insn(unsigned long addr)
+{
+	u32 insn = 0;
+
+	if (copy_from_kernel_nofault(&insn, (const void *)addr, sizeof(insn)))
+		return 0;
+	return insn;
+}
+
+static bool hk_insn_is_bti(u32 insn)
+{
+	return insn == 0xD503245F || insn == 0xD503249F || insn == 0xD50324DF ||
+	       insn == 0xD503251F;
+}
+
+static unsigned long __nocfi hk_follow_stub(unsigned long addr)
+{
+	int i;
+
+	for (i = 0; i < HK_STUB_FOLLOW; i++) {
+		u32 insn = hk_read_insn(addr);
+		long disp;
+
+		if (!insn)
+			return 0;
+		if (hk_insn_is_bti(insn)) {
+			addr += 4;
+			continue;
+		}
+		/* a bare branch at the entry is the stub the cfi build leaves behind */
+		if ((insn & 0xFC000000) != 0x14000000)
+			return addr;
+		disp = (long)(insn & 0x03FFFFFF) << 2;
+		if (disp & (1L << 27))
+			disp |= ~((1L << 28) - 1);
+		addr += disp;
+	}
+	return 0;
+}
+
+static unsigned long __nocfi hk_resolve_cfi(const char *name)
+{
+	unsigned long addr = 0;
+
+	/* asking hk_resolve here would ask this function again */
+	if (g_cfg.resolve && !g_exiting)
+		addr = g_cfg.resolve(name);
+	if (!addr || !hk_ker_addr_ok(addr))
+		return 0;
+	return hk_follow_stub(addr);
+}
+
+__nocfi noinline unsigned long hk_resolve(const char *name)
+{
+	unsigned long addr;
+
+	if (!name)
+		return 0;
+	if (g_cfg.resolve && !g_exiting) {
+		addr = g_cfg.resolve(name);
+		if (addr && hk_ker_addr_ok(addr))
+			return addr;
+	}
+	addr = hk_resolve_cfi(name);
+	if (addr && hk_ker_addr_ok(addr))
+		return addr;
+	return 0;
+}
+
+int hk_init(const struct hk_cfg *cfg)
+{
+	if (!cfg || !cfg->resolve)
+		return -EINVAL;
+	if (g_cfg.resolve && !g_exiting)
+		return -EALREADY;
+
+	g_cfg = *cfg;
+	g_exiting = false;
+	hk_patch_set_write(cfg->write);
+	/*
+	 * resolve the write path symbols here and not on first use: a lazy resolve
+	 * inside stop_machine would walk kallsyms from an atomic context
+	 */
+	hk_patch_init();
+	pr_info("[lkmhook] init\n");
+	return 0;
+}
+
+typedef void (*hk_synchronize_rcu_tasks_fn)(void);
+
+/*
+ * __nocfi on the body, not decoration: the symbol is resolved at runtime and the
+ * call is indirect, and the cfi typeid the compiler would check it against is not
+ * the one the kernel recorded. 5.10 panics on it, the target named in the message
+ */
+__nocfi /*
+ * the default notice is a warning, the level this library uses for a condition it
+ * refused and carried on from: the mistake belongs to the caller of the hook, not
+ * to the kernel, and a caller that wants it louder escalates in its own sink
+ */
+static void hk_notice_print(enum hk_notice what, const char *detail)
+{
+	static const char *const names[] = {
+		"free before disable",
+		"relo table",
+	};
+
+	pr_warn("[lkmhook] %s: %s\n",
+	       what < ARRAY_SIZE(names) ? names[what] : "notice",
+	       detail ? detail : "");
+}
+
+static hk_notify_fn g_notify = hk_notice_print;
+
+void hk_notice_set(hk_notify_fn fn)
+{
+	WRITE_ONCE(g_notify, fn);
+}
+
+void hk_notice(enum hk_notice what, const char *detail)
+{
+	hk_notify_fn fn = READ_ONCE(g_notify);
+
+	if (fn)
+		fn(what, detail);
+}
+
+/*
+ * the call inside is indirect and cfi is off for it, and noinline is the other
+ * half of that: an inline would move the call into whatever caller lto picked, and
+ * the check __nocfi turned off would come back with it
+ */
+__nocfi noinline void hk_wait_tasks_rcu(void)
+{
+	hk_synchronize_rcu_tasks_fn fn;
+	unsigned long sym = hk_resolve("synchronize_rcu_tasks");
+
+	if (!sym || !hk_ker_addr_ok(sym)) {
+		pr_warn_once("[lkmhook] synchronize_rcu_tasks not found, "
+			     "a freed trampoline may still be running\n");
+		return;
+	}
+	fn = (hk_synchronize_rcu_tasks_fn)sym;
+	fn();
+}
+
+void hk_exit(void)
+{
+	/*
+	 * called by hk_exit_block in a loop, so a restore that failed is retried.
+	 * the flag keeps the injected resolver out of the retry, a consumer that
+	 * tears its resolver down before hk_exit_block would otherwise resolve
+	 * through a freed pointer, and it is what makes a clean shutdown
+	 * initialize again instead of -EALREADY
+	 */
+	g_exiting = true;
+	hk_sighook_exit();
+	hk_kprobe_exit();
+	hk_kretprobe_exit();
+	hk_ptr_exit();
+	hk_inline_exit();
+	pr_info("[lkmhook] exit\n");
+}
+
+/*
+ * rmmod unmaps module text and data as soon as the exit path returns, and the
+ * entry of a hook that could not be restored still branches into the trampoline
+ * allocated here. the module ends its exit path through this instead of
+ * returning to its caller while a hook is still live: the detour keeps its
+ * bytes, so the kernel stays correct, and the rmmod request is the only thing
+ * that is refused. it never returns
+ */
+void hk_exit_block(void)
+{
+	unsigned int left;
+
+	for (;;) {
+		/*
+		 * the calls inside a replacement are counted here too: their code is
+		 * this module's, and the reference they hold is what keeps the kernel
+		 * from unmapping it, so a clean exit waits for them as well
+		 */
+		left = hk_inline_pending() + hk_ptr_pending() +
+		       hk_kprobe_pending() + hk_kretprobe_pending() +
+		       hk_redir_pending() + hk_redir_inflight();
+		if (!left)
+			break;
+		pr_warn("[lkmhook] exit blocked, %u hook(s) still live\n", left);
+		ssleep(60);
+		hk_inline_exit();
+		hk_ptr_exit();
+		hk_kretprobe_exit();
+	}
+	pr_info("[lkmhook] exit clean\n");
+	g_exiting = false;
+}
diff --git a/glue/hk/hk.h b/glue/hk/hk.h
new file mode 100644
index 0000000..056e134
--- /dev/null
+++ b/glue/hk/hk.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#ifndef LKMHOOK_HK_H
+#define LKMHOOK_HK_H
+
+#include <linux/types.h>
+
+struct hk_cfg {
+	unsigned long (*resolve)(const char *name);
+	/*
+	 * how the library writes text when a caller does not name a path itself,
+	 * one of the hk_write_* primitives of hk_patch.h. NULL takes the kernel's
+	 * own primitive, which assumes nothing about the headers this module was
+	 * built with. the value is read once, in hk_init
+	 */
+	int (*write)(void *dst, const void *src, size_t len);
+};
+
+static inline bool hk_ker_addr_ok(unsigned long v)
+{
+	return v >= 0xffff000000000000UL;
+}
+
+int hk_init(const struct hk_cfg *cfg);
+void hk_exit(void);
+unsigned long hk_resolve(const char *name);
+
+/*
+ * the consumers run their own exit, the library only counts the failures it was
+ * told about and keeps the numbers for the next hk_exit. a module whose exit
+ * path left kernel text pointing into module memory must not unload, so it calls
+ * hk_exit_block at the end of its own exit and never returns
+ */
+void hk_exit_fail(int count);
+unsigned int hk_exit_failed(void);
+void hk_exit_block(void);
+
+/*
+ * the library refuses something and carries on, and says so here. a refused free
+ * of a live hook and an emitter that disagrees with the length table both leave the
+ * hook or the install in a state the caller wanted, so a caller that wants to count
+ * them, log them its own way or trip an assertion of its own installs a notice
+ * function. the default notice prints, which is the report a plain build has, and
+ * hk_notice_set(NULL) silences it for a build that trusts itself
+ */
+enum hk_notice {
+	HK_NOTICE_FREE_BEFORE_DISABLE = 0,	/* a free on a hook that is still live */
+	HK_NOTICE_RELO_TABLE,			/* an emitter and the length table disagree */
+};
+
+typedef void (*hk_notify_fn)(enum hk_notice what, const char *detail);
+
+/* called where the refusal happens: process context, and it must not sleep */
+void hk_notice_set(hk_notify_fn fn);
+void hk_notice(enum hk_notice what, const char *detail);
+
+/*
+ * one tasks rcu grace period: what has to pass between the moment code of this
+ * module is taken out of a path another core could be running and the moment it is
+ * freed. it is the flavour the kernel uses for its own text pokes, the symbol is
+ * resolved here, and a kernel without it says so once instead of waiting for
+ * nothing. the call inside is indirect and cfi is off for it, a direct call from a
+ * consumer needs nothing
+ */
+void hk_wait_tasks_rcu(void);
+#endif
diff --git a/glue/hk/hk_cfi.c b/glue/hk/hk_cfi.c
new file mode 100644
index 0000000..9f19933
--- /dev/null
+++ b/glue/hk/hk_cfi.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+
+#include "hk.h"
+#include "hk_patch.h"
+#include "hk_cfi.h"
+
+#define HK_CFI_RET 0xD65F03C0
+#define HK_CFI_MOV 0xD2800020
+
+static int hk_patch_ret_addr(const char *what, unsigned long fn)
+{
+	u32 cur;
+	u32 ret = HK_CFI_RET;
+
+	if (!fn || !hk_ker_addr_ok(fn))
+		return -ENOENT;
+	if (copy_from_kernel_nofault(&cur, (void *)fn, sizeof(cur)))
+		return -EFAULT;
+	if (cur == ret)
+		return 0;
+	hk_write_text((void *)fn, &ret, 4);
+	pr_info("[lkmhook] cfi bypass %s\n", what);
+	return 0;
+}
+
+static int hk_patch_ret(const char *name)
+{
+	return hk_patch_ret_addr(name, hk_resolve(name));
+}
+
+static int hk_patch_mov_ret_addr(const char *what, unsigned long fn)
+{
+	u32 mov_ret[2] = { HK_CFI_MOV, HK_CFI_RET };
+	u32 cur;
+
+	if (!fn || !hk_ker_addr_ok(fn))
+		return -ENOENT;
+	if (copy_from_kernel_nofault(&cur, (void *)fn, sizeof(cur)))
+		return -EFAULT;
+	if (cur == mov_ret[0])
+		return 0;
+	hk_write_text((void *)fn, mov_ret, sizeof(mov_ret));
+	pr_info("[lkmhook] cfi bypass %s\n", what);
+	return 0;
+}
+
+int hk_cfi_bypass(void)
+{
+	static const char *const ret_syms[] = {
+		"cfi_failure_handler",
+		"__cfi_check_fail",
+		"__ubsan_handle_cfi_check_fail_abort",
+		"__ubsan_handle_cfi_check_fail",
+		"__cfi_slowpath",
+		"__cfi_slowpath_diag",
+		"_cfi_slowpath",
+	};
+	unsigned long fn;
+	int i;
+
+	for (i = 0; i < (int)ARRAY_SIZE(ret_syms); i++)
+		hk_patch_ret(ret_syms[i]);
+	fn = hk_resolve("report_cfi_failure");
+	hk_patch_mov_ret_addr("report_cfi_failure", fn);
+	return 0;
+}
