diff --git a/glue/vendor_kernel_syscalls.c b/glue/vendor_kernel_syscalls.c
index 12cf435..fb1bf74 100644
--- a/glue/vendor_kernel_syscalls.c
+++ b/glue/vendor_kernel_syscalls.c
@@ -8,6 +8,7 @@
 #include <linux/uaccess.h>
 #include <linux/capability.h>
 #include <linux/sched/task.h>
+#include <linux/fs_context.h>
 #include <linux/sched/signal.h>
 #include <linux/pid.h>
 #include <linux/pid_namespace.h>
@@ -102,6 +103,9 @@ static const char * const vendor_kernel_copy_namespaces_names[] = {
 static const char * const vendor_kernel_copy_creds_names[] = {
 	"copy_creds", NULL,
 };
+static const char * const vendor_kernel_mount_capable_names[] = {
+	"mount_capable", NULL,
+};
 
 #if defined(CONFIG_ARM64)
 static unsigned long vns_sys_arg0(const struct pt_regs *regs) { return regs->regs[0]; }
@@ -523,6 +527,59 @@ void vns_native___put_user_ns(struct user_namespace *ns)
 		real___put_user_ns(ns);
 }
 
+/*
+ * [MNT-USERNS] mount_capable() 补正。
+ *
+ * 真实内核 fs/super.c：
+ *
+ *   bool mount_capable(struct fs_context *fc)
+ *   {
+ *       if (!(fc->fs_type->fs_flags & FS_USERNS_MOUNT))
+ *           return capable(CAP_SYS_ADMIN);
+ *       return ns_capable(fc->user_ns, CAP_SYS_ADMIN);
+ *   }
+ *
+ * 而 alloc_fs_context()（fs/fs_context.c）里的
+ *
+ *   fc->user_ns = get_user_ns(fc->cred->user_ns);
+ *
+ * 在 CONFIG_USER_NS=n 下被编成 "= &init_user_ns"（get_user_ns() 的
+ * 该配置分支直接忽略参数），于是 fc->user_ns 永远是 init。tmpfs / proc /
+ * ramfs 都带 FS_USERNS_MOUNT，于是走到 ns_capable(init, CAP_SYS_ADMIN)，
+ * 而调用方的 cred 处在子 user namespace（level 1），cap_capable()
+ * 直接返回 -EPERM —— 表现为 userns 内 tmpfs/proc 挂载失败，而 bind
+ * mount（不新建 superblock，不经过 mount_capable）在同一环境里成功。
+ *
+ * 这里只在"内核自己算错"的那一种情况下补正：fc->user_ns 仍是 init，
+ * 但当前 cred 已经在子 userns 里。符合该条件时按调用方真实 userns
+ * 重新判定一次 capability；其他情况一律用内核原本的结论，不改行为。
+ */
+static bool (*real_mount_capable)(struct fs_context *fc);
+
+static bool vendor_kernel_hook_mount_capable(struct fs_context *fc)
+{
+	bool ret;
+
+	if (!real_mount_capable)
+		return false;
+
+	ret = real_mount_capable(fc);
+	if (ret)
+		return true;
+
+	if (fc && fc->user_ns == vns_real_init_user_ns) {
+		struct user_namespace *cur = vns_current_user_ns();
+
+		if (cur && cur != vns_real_init_user_ns)
+			return ns_capable(cur, CAP_SYS_ADMIN);
+	}
+	return false;
+}
+
+static struct shadow_hook vendor_kernel_mount_capable_hook =
+	SHADOW_HOOK(vendor_kernel_mount_capable_names,
+		    vendor_kernel_hook_mount_capable, &real_mount_capable);
+
 static struct shadow_hook vendor_kernel_unshare_hook =
 	SHADOW_HOOK(vendor_kernel_unshare_names, vendor_kernel_hook_unshare, &real_sys_unshare);
 static struct shadow_hook vendor_kernel_setns_hook =
@@ -603,6 +660,7 @@ struct shadow_hook *vendor_kernel_core_hooks[] = {
 	&vendor_kernel_put_user_ns_hook,
 	&vendor_kernel_copy_namespaces_hook,
 	&vendor_kernel_copy_creds_hook,
+	&vendor_kernel_mount_capable_hook,
 	NULL,
 };
 
diff --git a/vendor/kernel/nsproxy.c b/vendor/kernel/nsproxy.c
index 31d9e2a..02d8049 100644
--- a/vendor/kernel/nsproxy.c
+++ b/vendor/kernel/nsproxy.c
@@ -44,7 +44,13 @@
 #include <linux/nsproxy.h>
 #include <linux/init_task.h>
 #include <linux/mnt_namespace.h>
+#include <linux/ns_common.h>
+#include <linux/user_namespace.h>
 #include <linux/utsname.h>
+
+/* struct mount 的完整定义在私有头 fs/mount.h，这里只要指针，前向声明即可。 */
+struct mount;
+
 #include <linux/pid_namespace.h>
 #include <net/net_namespace.h>
 #include <linux/ipc_namespace.h>
@@ -268,6 +274,36 @@ static inline struct nsproxy *create_nsproxy(void)
  * matching the pattern used elsewhere in this module (see e.g.
  * vendor_kernel_procfs_userns.c's vns_idmap_create_fd()).
  */
+/*
+ * [MNT-USERNS] struct mnt_namespace 的 user_ns 字段偏移。
+ *
+ * 完整定义在私有头 fs/mount.h（6.1 布局，字段顺序见下），模块看不到。
+ * GKI 内核全部是 CONFIG_RANDSTRUCT_NONE=y，字段顺序 == 源码顺序，所以用
+ * 一份前缀假结构就能拿到 user_ns 的偏移。写之前会用
+ * vns_real_init_user_ns 做运行时校验：CONFIG_USER_NS=n 下 get_user_ns()
+ * 恒返回 init，因此真实 copy_mnt_ns() 建出的 mnt_ns 此刻的 user_ns 必是
+ * init —— 读到 init 才说明偏移正确，才改写；否则跳过，宁可不修 mount
+ * 也不写坏内存。
+ *
+ * 6.1 fs/mount.h：
+ *   struct mnt_namespace {
+ *       struct ns_common        ns;      // offset 0
+ *       struct mount *          root;
+ *       struct list_head        list;
+ *       spinlock_t              ns_lock;
+ *       struct user_namespace * user_ns; // <-- 目标字段
+ *       struct ucounts *        ucounts;
+ *       ...
+ *   } __randomize_layout;
+ */
+struct vns_mnt_namespace {
+	struct ns_common	ns;
+	struct mount		*root;
+	struct list_head	list;
+	spinlock_t		ns_lock;
+	struct user_namespace	*user_ns;
+};
+
 static __nocfi struct nsproxy *create_new_namespaces(unsigned long flags,
 	struct task_struct *tsk, struct user_namespace *user_ns,
 	struct fs_struct *new_fs)
@@ -286,6 +322,44 @@ static __nocfi struct nsproxy *create_new_namespaces(unsigned long flags,
 			err = PTR_ERR(new_nsp->mnt_ns);
 			goto out_ns;
 		}
+		/*
+		 * [MNT-USERNS] 把新 mount namespace 的归属修正回调用方给的
+		 * user_ns。
+		 *
+		 * 真实内核在 CONFIG_USER_NS=n 下把 get_user_ns() 编成
+		 *
+		 *     static inline struct user_namespace *get_user_ns(
+		 *                     struct user_namespace *ns)
+		 *     {
+		 *             return &init_user_ns;   // 忽略参数
+		 *     }
+		 *
+		 * 而 copy_mnt_ns() 用 alloc_mnt_ns(user_ns) 里的 get_user_ns()
+		 * 设置 new_ns->user_ns，于是新 mnt ns 永远"属于" init_user_ns。
+		 *
+		 * mount(2) 入口的 may_mount() 做
+		 *     ns_capable(current->nsproxy->mnt_ns->user_ns, CAP_SYS_ADMIN)
+		 * 拿 init（level 0）去对处于子 userns（level 1）的 cred 比较，
+		 * cap_capable() 直接返回 -EPERM —— 表现为 user namespace 内
+		 * 任何挂载（tmpfs / proc / bind）都 EPERM，而真 root 在 init 里
+		 * unshare -m 再挂载却正常。
+		 *
+		 * 这里只在确实进了子 userns（user_ns != init）时改写，所以
+		 * Android init 自己开机时的 unshare(CLONE_NEWNS)（user_ns 仍是
+		 * init）不会走进这个分支。CONFIG_USER_NS=n 下 get/put_user_ns
+		 * 都是空实现，没有引用计数要配平，直接赋值不会泄漏。
+		 *
+		 * 偏移用 vns_mnt_namespace 假结构 + init_user_ns 运行时校验
+		 * （见上面 struct vns_mnt_namespace 的注释），读不到 init 就
+		 * 跳过，宁可 mount 继续 EPERM 也不写坏内存。
+		 */
+		if (user_ns && new_nsp->mnt_ns &&
+		    user_ns != vns_real_init_user_ns) {
+			struct vns_mnt_namespace *vmnt =
+				(struct vns_mnt_namespace *)new_nsp->mnt_ns;
+			if (READ_ONCE(vmnt->user_ns) == vns_real_init_user_ns)
+				WRITE_ONCE(vmnt->user_ns, user_ns);
+		}
 	} else {
 		new_nsp->mnt_ns = NULL;
 	}
