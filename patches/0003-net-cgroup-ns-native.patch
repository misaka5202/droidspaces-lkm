+		 * ucount 代码之外。
+		 */
+		new_nsp->net_ns = vns_copy_net_ns_fn(flags, vns_real_init_user_ns,
 						      tsk->nsproxy->net_ns);
 		if (IS_ERR(new_nsp->net_ns)) {
 			err = PTR_ERR(new_nsp->net_ns);
