diff --git a/vendor/kernel/cgroup/namespace.c b/vendor/kernel/cgroup/namespace.c
index 5d5d706..aedaa22 100644
--- a/vendor/kernel/cgroup/namespace.c
+++ b/vendor/kernel/cgroup/namespace.c
@@ -29,12 +29,38 @@
 /* NS_COMMON_INIT must bind the static singleton to the vendored ops. */
 #define cgroupns_operations vns_cgroupns_operations
 
+/*
+ * [CGROUP-NS] 原生支持时走真实 copy_cgroup_ns()。
+ *
+ * 真实实现在 kernel/cgroup/namespace.c，不受单独 Kconfig 保护
+ * （CONFIG_CGROUPS=y 即编译），所以 vns_copy_cgroup_ns_fn 解析得到就说明
+ * 内核原生具备 cgroup namespace 能力。实测本设备：不加载本模块时
+ * unshare -C 能建出新 cgroup ns（cgroup:[4026531835] → cgroup:[4026537036]），
+ * 加载后反而恒返回 old_ns —— 原实现直接 (void)flags 忽略参数。
+ *
+ * 与 NET_NS 同理，这里传真实 init_user_ns 而不是 vendored user_ns：
+ * 真实 copy_cgroup_ns 在 CLONE_NEWCGROUP 路径上第一步就
+ * inc_cgroup_namespaces(user_ns) -> inc_ucount()，会沿途走 ns->ucounts
+ * 链并操作全局 ucounts_hashtable；vendored ns 的 ucount 记账与真实内核
+ * 不一致。CONFIG_USER_NS=n 的内核自己在这里用的就是 &init_user_ns。
+ */
 struct cgroup_namespace *vns_copy_cgroup_ns(unsigned long flags,
 					struct user_namespace *user_ns,
 					struct cgroup_namespace *old_ns) /* [RENAME] */
 {
-	(void)flags;
 	(void)user_ns;
+
+	if (vns_copy_cgroup_ns_fn) {
+		struct cgroup_namespace *ns;
+
+		ns = vns_copy_cgroup_ns_fn(flags, vns_real_init_user_ns, old_ns);
+		if (!IS_ERR(ns))
+			return ns;
+		/* 原生路径拒绝时退回共享旧 ns，保持与旧行为一致 */
+		get_cgroup_ns(old_ns); /* [BUILD-COMPAT] */
+		return old_ns;
+	}
+
 	get_cgroup_ns(old_ns); /* [BUILD-COMPAT] */
 	return old_ns;
 }
